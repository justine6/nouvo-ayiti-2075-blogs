// app/[locale]/blog/page.tsx
import Topbar from "@/components/Topbar";
import HeroPost from "@/components/blog/HeroPost";
import PostsGrid from "@/components/blog/PostsGrid";
import { getAllPosts } from "@/lib/get-all-posts";
import { getDictionary } from "@/lib/i18n/get-dictionary";
import type { Locale } from "@/lib/i18n/settings";

type Props = {
  params: { locale: Locale };
};

export default async function BlogPage({ params }: Props) {
  const { locale } = params;

  // 🌍 Load full dictionary for this locale
  const dict = await getDictionary(locale);

  // Localized label with safe fallbacks
  const readMoreLabel =
    dict?.blog?.readMore ??
    (locale === "fr"
      ? "Lire la suite"
      : locale === "ht"
      ? "Li plis"
      : locale === "es"
      ? "Leer más"
      : "Read more");

  // Try posts for this locale, then fall back to English
  let posts = getAllPosts(locale);
  if (!posts || posts.length === 0) {
    posts = getAllPosts("en");
  }

  const heroPost = posts[0];
  const morePosts = posts.slice(1);

  return (
    <>
      <Topbar locale={locale} />
      <main className="na-page">
        <section className="na-page-hero">
          <h1 className="na-page-title">
            {dict?.blog?.title ?? "Welcome to the Ayiti 2075 Blog"}
          </h1>
          <p className="na-page-lead">
            {dict?.blog?.subtitle ??
              "Stories, updates, and visions for the future."}
          </p>
        </section>

        {heroPost && (
          <HeroPost
            post={heroPost}
            locale={locale}
            readMoreLabel={readMoreLabel}
          />
        )}

        {morePosts.length > 0 && (
          <PostsGrid
            posts={morePosts}
            locale={locale}
            readMoreLabel={readMoreLabel}
          />
        )}
      </main>
    </>
  );
}
