@tailwind base;
@tailwind components;
@tailwind utilities;

html,
body { height: 100%; }

body {
  margin: 0;
  font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: translateY(0); }
}

.animate-fade-up { animation: fadeUp 0.6s ease-out both; }
