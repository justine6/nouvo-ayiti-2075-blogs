// app/components/Topbar.tsx
"use client";

import Link from "next/link";

type TopbarProps = {
  locale: string;
};

type NavLabels = {
  home: string;
  about: string;
  projects: string;
  blog: string;
  contact: string;
  vision: string;
};

const NAV_LABELS: Record<string, NavLabels> = {
  en: {
    home: "Home",
    about: "About",
    projects: "Projects",
    blog: "Blog",
    contact: "Contact",
    vision: "Vision",
  },
  fr: {
    home: "Accueil",
    about: "À propos",
    projects: "Projets",
    blog: "Blog",
    contact: "Contact",
    vision: "Vision",
  },
  ht: {
    home: "Lakay",
    about: "Sou nou",
    projects: "Pwojè",
    blog: "Blogo",
    contact: "Kontak",
    vision: "Vizyond lan",
  },
  es: {
    home: "Inicio",
    about: "Acerca de",
    projects: "Proyectos",
    blog: "Blog",
    contact: "Contacto",
    vision: "Visión",
  },
};

export default function Topbar({ locale }: TopbarProps) {
  // Labels stay translated
  const labels = NAV_LABELS[locale] ?? NAV_LABELS.en;

  // Main (marketing) site base – for Home / About / Contact / Vision
  const mainBase = `https://nouvoayiti2075.com/${locale}`;

  // Blog site base – for Blog + Projects
  const blogBase = `/${locale}`;

  return (
    <header className="na-topbar">
      <div className="na-topbar-inner">
        {/* Brand / logo */}
        <Link href={blogBase} className="na-topbar-brand">
          <span className="na-topbar-logo-circle">NA</span>
          <span className="na-topbar-title">Nouvo Ayiti 2075 — Blog</span>
        </Link>

        {/* Main navigation */}
        <nav aria-label="Main navigation">
          <ul className="na-topbar-nav">
            {/* These three go back to the MAIN site */}
            <li>
              <Link href={mainBase}>{labels.home}</Link>
            </li>
            <li>
              <Link href={`${mainBase}/about`}>{labels.about}</Link>
            </li>
            <li>
              <Link href={`${mainBase}/vision`}>{labels.vision}</Link>
            </li>

            {/* These two stay inside the BLOG site */}
            <li>
              <Link href={blogBase}>{labels.blog}</Link>
            </li>
            <li>
              <Link href={`${blogBase}/projects`}>{labels.projects}</Link>
            </li>

            {/* Contact back to main */}
            <li>
              <Link href={`${mainBase}/contact`}>{labels.contact}</Link>
            </li>
          </ul>
        </nav>

        {/* Language switcher stays exactly as translations expect */}
        <ul className="na-topbar-nav">
          <li>
            <Link href="/en">en</Link>
          </li>
          <li>
            <Link href="/fr">fr</Link>
          </li>
          <li>
            <Link href="/ht">ht</Link>
          </li>
          <li>
            <Link href="/es">es</Link>
          </li>
        </ul>
      </div>
    </header>
  );
}
