"use client";

import Link from "next/link";
import { usePathname } from "next/navigation";

type NavLabels = {
  home: string;
  about: string;
  projects: string;
  blog: string;
  contact: string;
  vision?: string;
  language?: string;
};

type TopbarProps = {
  // Optional – can come from layout or inferred from URL
  locale?: string;

  // For dictionaries: we’ll treat this as the translation bag
  dict?: Partial<NavLabels>;

  // Optional alternative name if you ever pass labels directly
  labels?: Partial<NavLabels>;
};

const SUPPORTED_LOCALES = ["en", "fr", "ht", "es"] as const;

const FALLBACK_LABELS: Record<string, NavLabels> = {
  en: {
    home: "Home",
    about: "About",
    projects: "Projects",
    blog: "Blog",
    contact: "Contact",
    vision: "Vision",
    language: "Language",
  },
  fr: {
    home: "Accueil",
    about: "À propos",
    projects: "Projets",
    blog: "Blog",
    contact: "Contact",
    vision: "Vision",
    language: "Langue",
  },
  ht: {
    home: "Akèy",
    about: "Konsènan",
    projects: "Pwojè",
    blog: "Blog",
    contact: "Kontak",
    vision: "Vizyo",
    language: "Lang",
  },
  es: {
    home: "Inicio",
    about: "Acerca de",
    projects: "Proyectos",
    blog: "Blog",
    contact: "Contacto",
    vision: "Visión",
    language: "Idioma",
  },
};

export default function Topbar(props: TopbarProps) {
  const pathname = usePathname();

  // 1) Detect locale from URL if not passed in props
  const segments = pathname?.split("/").filter(Boolean) ?? [];
  const urlLocale = segments[0];

  const effectiveLocale =
    (props.locale && SUPPORTED_LOCALES.includes(props.locale as any)
      ? props.locale
      : urlLocale && SUPPORTED_LOCALES.includes(urlLocale as any)
      ? urlLocale
      : "en") || "en";

  // 2) Merge dictionary labels (if any) with fallbacks
  const baseDefaults =
    FALLBACK_LABELS[effectiveLocale] ?? FALLBACK_LABELS.en;

  const fromDict = (props.dict || props.labels || {}) as Partial<NavLabels>;

  const labels: NavLabels = {
    home: fromDict.home ?? baseDefaults.home,
    about: fromDict.about ?? baseDefaults.about,
    projects: fromDict.projects ?? baseDefaults.projects,
    blog: fromDict.blog ?? baseDefaults.blog,
    contact: fromDict.contact ?? baseDefaults.contact,
    vision: fromDict.vision ?? baseDefaults.vision,
    language: fromDict.language ?? baseDefaults.language,
  };

  // ⚠️ KEY CHANGE:
  // We do NOT build hrefs like `/${locale}/...`.
  // We use plain root paths and let Next i18n add `/en`, `/fr`, `/ht`, `/es`.
  return (
    <header className="na-topbar">
      <div className="na-topbar-inner">
        <Link href="/" className="na-topbar-brand">
          <span className="na-topbar-logo-circle">NA</span>
          <span className="na-topbar-title">Nouvo Ayiti 2075 — Blog</span>
        </Link>

        <nav aria-label="Main navigation">
          <ul className="na-topbar-nav">
            <li>
              <Link href="/">{labels.home}</Link>
            </li>
            <li>
              <Link href="/about">{labels.about}</Link>
            </li>
            {labels.vision && (
              <li>
                <Link href="/vision">{labels.vision}</Link>
              </li>
            )}
            <li>
              <Link href="/blog">{labels.blog}</Link>
            </li>
            <li>
              <Link href="/projects">{labels.projects}</Link>
            </li>
            <li>
              <Link href="/contact">{labels.contact}</Link>
            </li>
          </ul>
        </nav>

        {/* Language switcher – keep FR + HT very visible */}
        <nav
          aria-label={labels.language ?? "Language"}
          className="na-topbar-nav-langs"
        >
          <ul className="na-topbar-nav">
            {SUPPORTED_LOCALES.map((code) => (
              <li key={code}>
                <Link href={`/${code}`}>{code}</Link>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
  );
}
