/* app/globals.css */
@tailwind base;
@tailwind components;
@tailwind utilities;

/* ===== Small reset (keep Tailwind in charge) ===== */
*,
*::before,
*::after { box-sizing: border-box; }

html, body { height: 100%; }

body {
  margin: 0;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: transparent;
  color: inherit;
}

/* ===== Layout shell ===== */
.na-page-shell { padding-top: 4.25rem; } /* space for fixed topbar */
.na-page-shell-inner {
  max-width: 72rem;           /* align with topbar */
  margin: 0 auto;
  padding: 2.25rem 1.5rem 4rem;
  min-height: calc(100vh - 4.25rem);
}

/* ===== Topbar ===== */
.na-topbar {
  position: fixed;
  inset: 0 0 auto 0;
  z-index: 40;
  background: rgba(255,255,255,.9);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(15,23,42,.06);
}

.na-topbar-inner {
  max-width: 72rem;
  margin: 0 auto;
  padding: .55rem 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.25rem;
}

.na-topbar-brand {
  display: inline-flex;
  align-items: center;
  gap: .6rem;
  text-decoration: none;
  color: #111827;
}

.na-topbar-logo-circle {
  width: 46px;
  height: 46px;
  border-radius: 999px;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 4px 18px rgba(212,0,0,.25);
}

.na-topbar-logo-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.na-topbar-brand-text {
  display: flex;
  flex-direction: column;
  font-weight: 700;
  font-size: .95rem;
}

.na-topbar-tagline {
  font-weight: 400;
  font-size: .75rem;
  color: #6b7280;
}

.na-topbar-nav {
  display: flex;
  justify-content: center;
  gap: 1.75rem;
  list-style: none;
  margin: 0;
  padding: 0;
  font-size: .9rem;
}

.na-topbar-link {
  position: relative;
  text-decoration: none;
  color: #374151;
  padding-bottom: .15rem;
  transition: color 150ms ease;
}

.na-topbar-link::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -.2rem;
  width: 0;
  height: 2px;
  background: #d40000;
  border-radius: 999px;
  transition: width 150ms ease-out;
}

.na-topbar-link:hover { color: #111827; }
.na-topbar-link:hover::after { width: 100%; }

.na-topbar-link-active {
  color: #111827;
  font-weight: 600;
}
.na-topbar-link-active::after { width: 100%; }

.na-topbar-right {
  display: flex;
  align-items: center;
  gap: .9rem;
}

/* Language pills */
.na-lang-switch {
  display: inline-flex;
  padding: .15rem;
  border-radius: 999px;
  background: rgba(15,23,42,.03);
  border: 1px solid rgba(148,163,184,.5);
  gap: .1rem;
}

.na-lang-pill {
  min-width: 2.4rem;
  padding: .25rem .7rem;
  border-radius: 999px;
  font-size: .75rem;
  font-weight: 600;
  letter-spacing: .04em;
  text-transform: uppercase;
  color: #222;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border: 1px solid #ddd;
  transition: background-color 140ms ease, color 140ms ease, transform 140ms ease, box-shadow 140ms ease;
}
.na-lang-pill:hover { background: #e5e5e5; color: #000; }

.na-lang-pill-active {
  background: #000;
  color: #fff;
  border-color: #000;
  box-shadow: 0 10px 22px rgba(0,0,0,.45);
  transform: translateY(-1px);
}

/* CTA (Haiti red) */
.na-topbar-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: .55rem 1.15rem;
  border-radius: 999px;
  font-size: .8rem;
  font-weight: 600;
  text-decoration: none;
  background: #d21034;
  color: #fff;
  box-shadow: 0 8px 24px rgba(210,16,52,.45);
  white-space: nowrap;
  transition: transform 150ms ease, box-shadow 150ms ease, filter 150ms ease;
}
.na-topbar-cta:hover {
  background: #b50e2c;
  transform: translateY(-2px);
  box-shadow: 0 12px 32px rgba(210,16,52,.65);
  filter: brightness(1.03);
}

/* Signature */
.na-topbar-signature {
  display: flex;
  align-items: center;
  gap: .5rem;
  font-size: .8rem;
  color: #6b7280;
}

.na-topbar-signature-avatar {
  width: 32px;
  height: 32px;
  border-radius: 999px;
  object-fit: cover;
  box-shadow: 0 0 0 2px #f9fafb, 0 10px 30px rgba(0,0,0,.45);
}
.na-topbar-signature-name {
  font-weight: 600;
  color: #111827;
}

/* ===== Hero (keep minimal; Tailwind handles most) ===== */
.na-hero { overflow: hidden; border-radius: 1.5rem; }
.na-hero-bg { position: relative; isolation: isolate; overflow: hidden; border-radius: 1.5rem; }
.na-hero-bg-map {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background-image: url("/images/haiti-map-hero.png");
  background-repeat: no-repeat;
  background-position: 0% center;
  background-size: 220% auto;
  opacity: .46;
  transition: transform 10s ease-out;
}
.na-hero:hover .na-hero-bg-map { transform: scale(1.05); }

.na-hero-bg-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background:
    radial-gradient(circle at 18% 20%, rgba(0,0,0,.28), transparent 60%),
    linear-gradient(to right, rgba(0,0,0,.30), rgba(0,0,0,.08));
  mix-blend-mode: multiply;
}

.na-hero-inner { position: relative; z-index: 2; }

/* Hero buttons */
.na-btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: .85rem 1.9rem;
  border-radius: 999px;
  font-weight: 600;
  font-size: .95rem;
  background: linear-gradient(135deg, #d21034, #a50c2a);
  color: #fff;
  box-shadow: 0 10px 28px rgba(210,16,52,.55);
  transition: transform 200ms ease, box-shadow 200ms ease, filter 200ms ease;
}
.na-btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 14px 36px rgba(210,16,52,.7);
  filter: brightness(1.02);
}

.na-btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: .85rem 1.9rem;
  border-radius: 999px;
  font-weight: 600;
  font-size: .95rem;
  background: #000;
  color: #fff;
  box-shadow: 0 10px 28px rgba(0,0,0,.55);
  transition: transform 200ms ease, box-shadow 200ms ease;
}
.na-btn-secondary:hover {
  background: #111;
  transform: translateY(-2px);
  box-shadow: 0 14px 36px rgba(0,0,0,.7);
}

/* ===== Simple cards/grids (home/blog/projects) ===== */
.na-grid { display: grid; gap: 1.5rem; }
.na-card {
  border-radius: 1rem;
  padding: 1.5rem;
  background: #fff;
  border: 1px solid rgba(148,163,184,.4);
  box-shadow: 0 10px 25px rgba(15,23,42,.04);
  transition: transform 150ms ease, box-shadow 150ms ease, border-color 150ms ease;
}
.na-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 20px 45px rgba(15,23,42,.12);
  border-color: rgba(148,163,184,.75);
}

/* Blog grid (if you use na-blog-grid on /blog) */
.na-blog-grid {
  display: grid;
  gap: 1.5rem;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
}

/* ===== Animation ===== */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}
.animate-fade-up { animation: fadeUp .6s ease-out both; }

/* ===== Responsive ===== */
@media (max-width: 900px) {
  .na-topbar-inner { flex-wrap: wrap; gap: .75rem; }
  .na-topbar-nav { width: 100%; flex-wrap: wrap; gap: 1rem; order: 3; }
  .na-topbar-right { order: 2; }
  .na-page-shell { padding-top: 4.75rem; }
}

@media (max-width: 640px) {
  .na-topbar-brand-text { display: none; }
  .na-topbar-signature { display: none; }
}


/* Topbar nav lane */
.na-topbar-nav-wrap { flex: 1; }

