#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks…"

# ---- 1) Validate + Repair JSON ----
npm run validate:repair

# ---- 2) Sync locale dictionaries ----
npm run sync

# ---- 3) Strict dictionary + translation checks ----
npm run check-dicts:strict
npm run check-translation-sync:strict
npm run check-topbar-footer:strict

# ---- 4) Video catalog must match locale JSON ids ----
npm run guardian:videos

# ---- 5) Run ESLint+Prettier only on staged files ----
npx lint-staged

echo "✅ All checks passed — committing!"
